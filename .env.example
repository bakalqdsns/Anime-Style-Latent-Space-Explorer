# Application
APP_NAME=Anime Visual Language Engine
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://anime_user:anime_password@localhost:5432/anime_engine
# For local dev without postgres, use sqlite:
# DATABASE_URL=sqlite+aiosqlite:///./data/anime_engine.db

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=keyframes

# Redis (Phase 5 - Celery)
REDIS_URL=redis://localhost:6379/0

# LLM - DeepSeek (Primary)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-38867806a53f4fba9bd25c164530df45
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Fallback to OpenAI if needed
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# CLIP Model
CLIP_MODEL=openai/clip-vit-large-patch14

# DINOv2 Model
DINOV2_MODEL=facebook/dinov2-vitl14

# Data Paths
DATA_DIR=./data
DATA_RAW_DIR=./data/raw
DATA_FRAMES_DIR=./data/frames
DATA_CACHE_DIR=./data/cache
DATA_OUTPUT_DIR=./data/output

# Embedding Cache
EMBEDDING_CACHE_DIR=./data/cache/embeddings
AXIS_CACHE_DIR=./data/cache/axes

# Style Axis Definitions (JSON file path)
STYLE_AXES_CONFIG=./data/style_axes.json

# Cluster Parameters
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.1
HDBSCAN_MIN_CLUSTER_SIZE=50
HDBSCAN_MIN_SAMPLES=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
